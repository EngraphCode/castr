{
  "openapi": "3.1.0",
  "info": {
    "title": "Local User example",
    "version": "1.0.0"
  },
  "paths": {
    "/user": {
      "get": {
        "operationId": "getUser",
        "responses": {
          "200": {
            "description": "A user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
