# Single source of truth for the gitleaks security pin.
# Consumers: .claude/hooks/ensure-gitleaks.sh (SessionStart provisioning) and
# .github/workflows/ci.yml secret-scan job. .gitleaks.toml's minVersion must
# equal GITLEAKS_VERSION (the hook cross-checks and warns on drift).
# The sha256 is content-bound to the linux_x64 release asset of this version.
GITLEAKS_VERSION=8.30.0
GITLEAKS_SHA256_LINUX_X64=79a3ab579b53f71efd634f3aaf7e04a0fa0cf206b7ed434638d1547a2470a66e
